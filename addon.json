{
  "id": "addon.grocery-flywheel",
  "name": "Grocery Flywheel",
  "version": "0.1.0",
  "author": "KyaniteLabs",
  "category": "tool",
  "sdkVersion": "0.1.0",
  "description": "Local-first grocery replenishment: runway estimates, fail-closed dietary checks, sourcing research, and a next-cart draft that always waits for a human yes. Runs entirely on your machine; checkout does not exist.",
  "runtimeType": "local-service",
  "surfaces": [],
  "requestedCapabilities": [],
  "provenance": {
    "tier": "sideloaded-unverified",
    "verificationState": "unverified",
    "signed": false
  },
  "runtimeIsolation": {
    "boundary": "host-mediated-service",
    "supportsDegradedMode": true,
    "requiresReviewedGrant": true
  },
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": false
  },
  "systemSlots": [],
  "archiveIntegration": {
    "readScopes": [],
    "intakeWriteScopes": [],
    "canRequestIngest": false,
    "canWriteKnowledgePages": false
  },
  "health": {
    "strategy": "http-json-status"
  },
  "service": {
    "protocol": "http-json",
    "entrypoint": "http://127.0.0.1:4899",
    "healthCommand": "groceryflywheel.status"
  },
  "tools": [
    {
      "name": "groceryflywheel.status",
      "description": "Report service version, busy state, and the most recent dashboard path.",
      "requiredCapabilities": [],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "tool": { "type": "string" },
          "version": { "type": "string" },
          "busy": { "type": "boolean" },
          "last_dashboard": { "type": ["string", "null"] }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "groceryflywheel.analyze",
      "description": "Analyze an inline replenishment state (upstream analyze_replenishment_state): runway, depletion, roles, freshness, dietary evaluations, substitutions. State arrives as state_json text; this wrapper accepts no filesystem paths.",
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state_json": { "type": "string", "description": "A Grocery Flywheel state document as JSON text (at most 60000 characters)" },
          "objective": { "type": "string", "enum": ["allergy_safe", "balanced_roi", "best_quality", "dietary_restrictions", "fewer_trips", "lowest_cost", "lowest_decision_fatigue"] }
        },
        "required": ["state_json"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "estimated_days_remaining": { "type": ["number", "null"] },
          "known_consumed_fraction": { "type": "number" },
          "data_warnings": { "type": "array" },
          "dietary_evaluations": { "type": "array" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "groceryflywheel.dietary",
      "description": "Evaluate every item against the state's dietary restriction profiles with fail-closed safety logic: safety-critical restrictions without current label evidence return needs_review, never safe (upstream evaluate_dietary).",
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state_json": { "type": "string" },
          "objective": { "type": "string", "enum": ["allergy_safe", "balanced_roi", "best_quality", "dietary_restrictions", "fewer_trips", "lowest_cost", "lowest_decision_fatigue"] }
        },
        "required": ["state_json"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "objective": { "type": ["string", "null"] },
          "counts_by_result": { "type": "object" },
          "evaluations": { "type": "array" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "groceryflywheel.sourcing",
      "description": "Extract sourcing research questions and decision boundaries recorded in the state (upstream summarize_sourcing_research): count plus per-item current_source, research_question, decision_boundary.",
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state_json": { "type": "string" }
        },
        "required": ["state_json"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "items": { "type": "array" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "groceryflywheel.plan",
      "description": "Draft the next cart from observed depletion plus sourcing moves (upstream plan_next_cart). Every item is needs_human_approval, approval_required is true, checkout_available is structurally false - the vendored engine raises if that boundary is ever violated. This tool never places orders.",
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state_json": { "type": "string" },
          "objective": { "type": "string", "enum": ["allergy_safe", "balanced_roi", "best_quality", "dietary_restrictions", "fewer_trips", "lowest_cost", "lowest_decision_fatigue"] },
          "mode": { "type": "string", "enum": ["pickup", "delivery", "in_person"] }
        },
        "required": ["state_json"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mode": { "type": "string" },
          "approval_required": { "type": "boolean" },
          "checkout_available": { "type": "boolean" },
          "item_count": { "type": "integer" },
          "items": { "type": "array" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "groceryflywheel.dashboard",
      "description": "Render the dark command-center dashboard as a self-contained HTML file under the addon's var/dashboards/ directory (upstream render_replenishment_dashboard, write-confined here). Returns output_path (addon-relative) and the analyzed item count.",
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state_json": { "type": "string" },
          "objective": { "type": "string", "enum": ["allergy_safe", "balanced_roi", "best_quality", "dietary_restrictions", "fewer_trips", "lowest_cost", "lowest_decision_fatigue"] },
          "filename": { "type": "string", "description": "Optional file name (letters, digits, dot, underscore, hyphen; .html appended when missing); paths are rejected", "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
        },
        "required": ["state_json"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "output_path": { "type": "string" },
          "items": { "type": "integer" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    }
  ],
  "installHooks": {
    "onInstall": "start-grocery-flywheel-service"
  },
  "compatibility": {
    "shellVersion": "^0.1.0",
    "platforms": ["macOS", "linux", "windows"]
  }
}
